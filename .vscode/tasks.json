{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db:start",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/compose.dev.yml",
        "up",
        "-d",
        "postgres",
        "mongo"
      ],
      "problemMatcher": []
    },
    {
      "label": "db:stop",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/compose.dev.yml",
        "down"
      ],
      "problemMatcher": []
    }
  ]
}
